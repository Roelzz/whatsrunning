# Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Logging
LOG_LEVEL=INFO

# Data Collection
POLL_INTERVAL_SECONDS=10
PORT_SCAN_INTERVAL_SECONDS=60
PORT_SCAN_RANGE=1024-10000

# Docker Socket (for containerized deployment)
# When running as a container, use the mounted Docker socket
DOCKER_HOST=unix:///var/run/docker.sock

# NPM Database
NPM_DATA_PATH=/DATA/AppData/nginxproxymanager/data
NPM_DB_PATH=/data/database.sqlite

# Session
SESSION_SECRET_KEY=generate-random-secret-key-here
SESSION_EXPIRY_HOURS=24

# Reflex Backend API URL (accessible from browser)
REFLEX_API_URL=http://192.168.68.105:2010
